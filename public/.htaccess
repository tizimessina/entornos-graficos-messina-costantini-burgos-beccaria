<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o la carpeta pedida existe de verdad (CSS, JS, imágenes), serví eso.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás pasa por el front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# CSS, JS e imágenes se guardan en el navegador por un año. Las vistas los piden
# con su fecha de modificación (?v=...), así que un cambio cambia la URL y no
# queda una versión vieja en caché.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
